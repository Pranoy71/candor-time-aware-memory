# Copy to .env and fill in ONE provider. Nothing here is required: with no key, Candor still runs
# (deterministic retrieval + extractive answers + rule-based actions), just with weaker answers.

# --- Gemini free tier (default). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The only model Candor uses (override only if the id differs in your AI Studio).
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Alternatives (used only if no Gemini key is set)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Seconds between LLM calls. 6.5 keeps a free key under ~10 requests/minute.
# CANDOR_MIN_INTERVAL=6.5
